# Self-hosted Censai configuration. Copy this file to .env and fill in secrets.
CENSAI_MODE=local_desktop
# Legacy alias for older deployments that have not moved to CENSAI_MODE.
HOMEBASE_MODE=

# Default chat route: Ollama-compatible local endpoint.
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=minimax-m2.5:cloud

# PostgreSQL. Docker exposes the bundled database on host port 5433.
DATABASE_URL=postgresql://homebase:homebase@127.0.0.1:5433/homebase

# Required in production. Generate independent random values of 32+ characters.
SESSION_SECRET=
JOURNAL_SECRET=
CENSAI_VAULT_SECRET=

# Optional Qdrant vector search.
QDRANT_URL=http://127.0.0.1:6335

# Embeddings use Ollama by default.
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
COHERE_PAID_API_KEY=
COHERE_NON_COMMERCIAL_KEY=
COHERE_API_KEY=
COHERE_CHAT_BASE_URL=https://api.cohere.ai/compatibility/v1
COHERE_BASE_URL=
COHERE_EMBEDDING_DIMENSION=

# App and Google OAuth.
APP_ORIGIN=http://localhost:5173
CENSAI_FEATURE_WINDOW_IMPORT=false
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
GOOGLE_TOKENS_PATH=.homebase-state/google_tokens.json

# Optional AI providers.
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_API_KEY=

# Optional Google APIs.
GOOGLE_CLOUD_API_KEY=
YOUTUBE_API_KEY=

# Optional integrations.
MAILCOW_URL=
MAILCOW_API_KEY=
LINEAR_API_KEY=

# Dangerous execution plane. Production defaults to disabled.
RUNNER_ENABLED=
RUNNER_URL=http://localhost:3003
RUNNER_SECRET=

# Optional external repository audit integration.
OVERSEER_SCRIPT_PATH=
OVERSEER_SCRIPT_CWD=
OVERSEER_DEFAULT_REPO=

# Server logging.
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_DIR=.homebase-state/logs
LOG_RETENTION_DAYS=14
LOG_MAX_BYTES=100mb
LOG_CLEANUP_INTERVAL_HOURS=24

# Optional sandbox CLI toolchains: opencode, gemini, codex, claudecode.
SANDBOX_TOOLCHAINS=
OPENCODE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
