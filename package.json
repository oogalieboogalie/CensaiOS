{
  "name": "censai",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:full": "npm test -- --shard=1/2 && npm test -- --shard=2/2",
    "test:integrity": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/integrity.test.js",
    "check": "npm run lint && npm run test:full && npm run build",
    "gate": "npm run check && npm run window:validate && npm run audit:ai-first && npm run size:check && npm run guard:tests",
    "packages:validate-cognitive-load": "node scripts/packages/cognitive-load-validate.mjs",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand",
    "dev": "concurrently -k -s first \"node --watch server.js\" \"node scripts/dev-client-after-api.mjs\"",
    "dev:client": "npx vite",
    "dev:server": "node --watch server.js",
    "build": "npx vite build",
    "preview": "npx vite preview",
    "kill": "powershell -NoProfile -Command \"Get-Process node -ErrorAction SilentlyContinue | Stop-Process -Force; Write-Host 'killed all node processes'\"",
    "sandbox:build": "docker build -f docker/sandbox.Dockerfile -t homebase-sandbox:latest .",
    "window:list": "node scripts/window-sdk.mjs list",
    "window:validate": "node scripts/window-sdk.mjs validate",
    "window:scaffold": "node scripts/window-sdk.mjs scaffold",
    "window:new": "node scripts/window-sdk.mjs new",
    "window:lab": "npx vite --open /window-lab.html",
    "lint": "eslint .",
    "security": "node scripts/security-tripwires.mjs",
    "window:sync": "node scripts/window-sync.mjs",
    "window:check": "node scripts/window-sync.mjs --check",
    "dev:tauri": "tauri dev"
  },
  "dependencies": {
    "@a2a-js/sdk": "0.3.14",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@google/genai": "^2.6.0",
    "@kubernetes/client-node": "^2.0.0",
    "@octokit/rest": "22.0.1",
    "@uiw/codemirror-themes": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "cors": "^2.8.6",
    "dom-to-image-more": "^3.7.2",
    "dompurify": "3.4.15",
    "dotenv": "^17.4.2",
    "eslint-plugin-ai-debt": "file:./tools/eslint-plugin-ai-debt",
    "express": "^5.2.1",
    "express-rate-limit": "8.6.0",
    "express-session": "^1.19.0",
    "framer-motion": "^12.40.0",
    "googleapis": "^172.0.0",
    "html2canvas": "^1.4.1",
    "ipaddr.js": "1.9.1",
    "js-yaml": "^5.1.0",
    "lru-cache": "^11.5.1",
    "node-pty": "^1.1.0",
    "pg": "^8.16.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@tauri-apps/cli": "^2.11.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "babel-jest": "^30.4.1",
    "concurrently": "^10.0.3",
    "eslint": "^8.57.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.15",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.14"
  },
  "overrides": {
    "qs": "6.16.0",
    "nanoid": "3.3.8",
    "lodash-es": "4.18.1"
  },
  "license": "Apache-2.0"
}
