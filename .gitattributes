# Normalize line endings: store LF in the repo, check out LF everywhere.
* text=auto eol=lf

# Windows-only scripts need CRLF to run correctly
*.bat text eol=crlf
*.ps1 text eol=crlf

# Treat these as binary (never normalize / diff)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.mp3 binary
*.mp4 binary
*.zip binary
*.gz binary

# Vendored game runtimes stay byte-for-byte as upstream shipped them
public/playground/vendor/** binary
*.wasm binary
